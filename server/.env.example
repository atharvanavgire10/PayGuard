# PayGuard API configuration. Copy to server/.env and fill in real values.
# server/.env is gitignored and must never be committed.

# development enables the reliability dashboard, POST /api/reconciliation/run, the scheduled
# reconciliation worker, and checkout diagnostics. Any other value disables all of them.
NODE_ENV=development
PORT=5000

# Required in every environment.
MONGODB_URI=mongodb://127.0.0.1:27017/payguard

# Razorpay Test Mode only. PayGuard rejects a key that is not rzp_test_*, and never processes real
# money. Required in production; without them checkout returns 503.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
# From the Razorpay webhook configuration, not the API key secret. Webhooks return 503 without it.
RAZORPAY_WEBHOOK_SECRET=replace_me

# Allowed browser origin for CORS. Falls back to http://localhost:5173 when unset.
CLIENT_URL=http://localhost:5173

# Optional. Scheduled reconciliation interval in milliseconds; 0 disables the worker.
# Values below 1000 or non-integers also disable it. Default 300000 (5 minutes).
RECONCILIATION_INTERVAL_MS=300000

# Optional. Minutes a payment may stay PENDING before the dashboard flags it. Default 15.
DASHBOARD_PENDING_MINUTES=15
